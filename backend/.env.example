# backend/.env 로 복사한 뒤 값을 채우세요. (cp .env.example .env)
# 이 파일은 예시만 담고, 비밀번호·시크릿은 저장소에 넣지 마세요.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=HanuriProject

# --- JWT (운영에서는 긴 무작위 문자열로 변경) ---
JWT_SECRET=change-me-to-a-long-random-string-in-production

# --- SMTP (가입 거절 메일 등, Gmail은 앱 비밀번호 권장) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=하누리

# 사용자에게 보여지는 웹 프론트 베이스 URL (가입 거절·비밀번호 재설정 등 메일 링크에 사용).
# HTTP 기본 포트 80·HTTPS는 443 (URL에 포트 생략). 예: http://localhost / https://mtaoft.shop
# Vite 개발 서버를 80으로 띄우면 메일의 http://localhost/... 링크와 같아짐(Windows는 관리자 권한 필요할 수 있음).
APP_PUBLIC_URL=http://localhost
