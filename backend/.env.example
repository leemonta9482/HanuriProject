# backend/.env 로 복사한 뒤 값을 채우세요. (cp .env.example .env)
# 이 파일은 예시만 담고, 비밀번호·시크릿은 저장소에 넣지 마세요.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=HanuriProject

# --- JWT (운영에서는 긴 무작위 문자열로 변경) ---
JWT_SECRET=change-me-to-a-long-random-string-in-production

# --- SMTP (가입 거절 메일 등, Gmail은 앱 비밀번호 권장) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=하누리

# 프론트 가입 페이지 링크(거절 메일 본문)
APP_PUBLIC_URL=http://localhost:5173
