# `npm run build` 시 포함됩니다. 이 파일을 복사해 `.env.production` 으로 두고 값을 채우세요.

# Cloudflare Tunnel: 반드시 https + 포트 없음 (Mixed Content 방지)
# VITE_API_BASE_URL=https://mtaoft.shop

# 로컬: 프론트 80·백엔드 4173 — 아래 둘 중 하나 (`http://127.0.0.1` 만 적으면 80으로 가서 404)
# VITE_API_BASE_URL=http://127.0.0.1:4173
# VITE_API_BACKEND_PORT=4173
