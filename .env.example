# 루트 .env — docker compose 가 읽는다 (cp .env.example .env). 비밀번호·시크릿은 저장소에 넣지 마세요.
# my-cloudflare 대시보드로 올렸다면 서버 카드 ⋯ → ".env 편집" 이 이 파일이다. PORT 는 대시보드가 채운다.

# nginx 가 127.0.0.1:PORT 로 듣는다 (터널이 여기로 연결)
PORT=8080

# --- MySQL (compose 의 db 컨테이너 root 비밀번호, 백엔드가 같은 값으로 접속) ---
DB_PASSWORD=change-me

# --- JWT (32바이트 이상 무작위: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
JWT_SECRET=change-me-to-a-long-random-string

# --- 메일 링크 베이스 (공개 도메인) ---
APP_PUBLIC_URL=https://hanuri.example.com

# --- SMTP (가입 인증·거절·비밀번호 재설정 메일) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=하누리
